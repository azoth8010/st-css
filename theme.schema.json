{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SillyTavern Theme Fields",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name", "blur_strength", "main_text_color", "italics_text_color", "underline_text_color",
    "quote_text_color", "blur_tint_color", "chat_tint_color", "user_mes_blur_tint_color",
    "bot_mes_blur_tint_color", "shadow_color", "shadow_width", "border_color", "font_scale",
    "fast_ui_mode", "waifuMode", "avatar_style", "chat_display", "toastr_position", "noShadows",
    "chat_width", "timer_enabled", "timestamps_enabled", "timestamp_model_icon",
    "mesIDDisplay_enabled", "hideChatAvatars_enabled", "message_token_count_enabled",
    "expand_message_actions", "enableZenSliders", "enableLabMode", "hotswap_enabled",
    "custom_css", "bogus_folders", "zoomed_avatar_magnification", "reduced_motion",
    "compact_input_area", "show_swipe_num_all_messages", "click_to_edit", "media_display"
  ],
  "properties": {
    "name": { "type": "string" },
    "blur_strength": { "type": "number", "minimum": 0 },
    "main_text_color": { "type": "string", "pattern": "^rgba\\(\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*(?:0|1|0?\\.\\d+)\\s*\\)$" },
    "italics_text_color": { "type": "string", "pattern": "^rgba\\(\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*(?:0|1|0?\\.\\d+)\\s*\\)$" },
    "underline_text_color": { "type": "string", "pattern": "^rgba\\(\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*(?:0|1|0?\\.\\d+)\\s*\\)$" },
    "quote_text_color": { "type": "string", "pattern": "^rgba\\(\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*(?:0|1|0?\\.\\d+)\\s*\\)$" },
    "blur_tint_color": { "type": "string", "pattern": "^rgba\\(\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*(?:0|1|0?\\.\\d+)\\s*\\)$" },
    "chat_tint_color": { "type": "string", "pattern": "^rgba\\(\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*(?:0|1|0?\\.\\d+)\\s*\\)$" },
    "user_mes_blur_tint_color": { "type": "string", "pattern": "^rgba\\(\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*(?:0|1|0?\\.\\d+)\\s*\\)$" },
    "bot_mes_blur_tint_color": { "type": "string", "pattern": "^rgba\\(\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*(?:0|1|0?\\.\\d+)\\s*\\)$" },
    "shadow_color": { "type": "string", "pattern": "^rgba\\(\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*(?:0|1|0?\\.\\d+)\\s*\\)$" },
    "shadow_width": { "type": "number", "minimum": 0 },
    "border_color": { "type": "string", "pattern": "^rgba\\(\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*(?:0|1|0?\\.\\d+)\\s*\\)$" },
    "font_scale": { "type": "number", "minimum": 0 },
    "fast_ui_mode": { "type": "boolean" },
    "waifuMode": { "type": "boolean" },
    "avatar_style": { "type": "integer", "enum": [0, 1] },
    "chat_display": { "type": "integer", "enum": [0, 1] },
    "toastr_position": { "type": "string" },
    "noShadows": { "type": "boolean" },
    "chat_width": { "type": "number", "minimum": 0 },
    "timer_enabled": { "type": "boolean" },
    "timestamps_enabled": { "type": "boolean" },
    "timestamp_model_icon": { "type": "boolean" },
    "mesIDDisplay_enabled": { "type": "boolean" },
    "hideChatAvatars_enabled": { "type": "boolean" },
    "message_token_count_enabled": { "type": "boolean" },
    "expand_message_actions": { "type": "boolean" },
    "enableZenSliders": { "type": "boolean" },
    "enableLabMode": { "type": "boolean" },
    "hotswap_enabled": { "type": "boolean" },
    "custom_css": { "type": "string" },
    "bogus_folders": { "type": "boolean" },
    "zoomed_avatar_magnification": { "type": "boolean" },
    "reduced_motion": { "type": "boolean" },
    "compact_input_area": { "type": "boolean" },
    "show_swipe_num_all_messages": { "type": "boolean" },
    "click_to_edit": { "type": "boolean" },
    "media_display": { "type": "string" }
  }
}
